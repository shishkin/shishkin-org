{
  "name": "shishkin.org",
  "version": "1.0.0",
  "description": "Personal site",
  "type": "module",
  "scripts": {
    "start": "node --watch server.ts",
    "generate": "node node_modules/@mastrojs/mastro/src/generator.js --output dist",
    "build": "tsc --noEmit && pnpm run generate"
  },
  "imports": {
    "#*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shishkin/shishkin-org.git"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "keywords": [],
  "author": "Sergey Shishkin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shishkin/shishkin-org/issues"
  },
  "homepage": "https://github.com/shishkin/shishkin-org#readme",
  "dependencies": {
    "@iconify-json/carbon": "1.2.26",
    "@iconify-json/fa": "1.2.2",
    "@iconify-json/ion": "1.2.7",
    "@mastrojs/mastro": "jsr:0.8.6",
    "@remix-run/node-fetch-server": "0.14.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
