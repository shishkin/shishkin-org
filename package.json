{
  "name": "shishkin.org",
  "version": "1.0.0",
  "description": "Personal site",
  "type": "module",
  "scripts": {
    "start": "node --watch server.ts",
    "generate": "node node_modules/@mastrojs/mastro/src/generator.js --output dist",
    "build": "tsc --noEmit && pnpm run generate"
  },
  "imports": {
    "#*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shishkin/shishkin-org.git"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "keywords": [],
  "author": "Sergey Shishkin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shishkin/shishkin-org/issues"
  },
  "homepage": "https://github.com/shishkin/shishkin-org#readme",
  "dependencies": {
    "@iconify-json/carbon": "1.2.28",
    "@iconify-json/fa": "1.2.2",
    "@iconify-json/ion": "1.2.7",
    "@mastrojs/mastro": "jsr:0.8.6",
    "@remix-run/node-fetch-server": "0.14.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e"
}
